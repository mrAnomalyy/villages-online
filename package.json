{
  "name": "villages-online",
  "private": true,
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "dev:web": "yarn workspace web dev",
    "dev:gateway": "yarn workspace gateway dev",
    "dev:realm:alpha": "yarn workspace realm dev:alpha",
    "dev:realm:beta": "yarn workspace realm dev:beta",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "yarn workspaces foreach -A run lint",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down -v",
    "docker:test:e2e": "docker compose -f docker-compose.yml -f docker-compose.test.yml run --rm tester"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
