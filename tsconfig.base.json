{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@villages/shared": ["packages/shared/src/index.ts"],
      "@villages/shared/*": ["packages/shared/src/*"],
      "@villages/world": ["packages/world/src/index.ts"],
      "@villages/world/*": ["packages/world/src/*"]
    }
  }
}
